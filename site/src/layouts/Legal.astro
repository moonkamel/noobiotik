---
import Base from './Base.astro';
interface Props { title: string; path: string; updated: string }
const { title, path, updated } = Astro.props;
---
<Base title={`${title} | Probio Décodé`} path={path} description={`${title} du site Probio Décodé.`}>
  <article class="container legal">
    <p class="eyebrow">Mis à jour le {updated}</p>
    <h1>{title}</h1>
    <slot />
  </article>
</Base>

<style>
  .legal { max-width: 760px; padding-block: clamp(48px, 8vw, 112px); }
  .legal h1 { font-size: var(--fs-2xl); margin-bottom: 32px; }
  .legal :global(h2) { font-size: var(--fs-xl); margin: 40px 0 12px; }
  .legal :global(p), .legal :global(li) { color: var(--ink-2); }
  .legal :global(p + p), .legal :global(ul) { margin-top: 12px; }
  .legal :global(ul) { padding-left: 1.2em; display: grid; gap: 6px; }
  .legal :global(mark) { background: #FFF3C4; color: #5C4400; padding: 0 4px; border-radius: 4px; }
</style>
