---
const traps = [
  {
    title: '« Lactobacillus » sans code de souche',
    text: "Une espèce regroupe des centaines de souches aux propriétés différentes. Sans le code (ex. « GG », « Rosell-52 »), impossible de relier le produit à la moindre étude.",
  },
  {
    title: 'Des UFC comptées « à la fabrication »',
    text: "Les bactéries vivantes déclinent avec le temps. Ce qui compte, c'est la quantité garantie jusqu'à la date de durabilité, pas celle du jour de la mise en gélule.",
  },
  {
    title: 'Des excipients dont on se passerait',
    text: "Dioxyde de titane, stéarate de magnésium, colorants : ils facilitent la production, pas votre routine. Ils sont pourtant fréquents en bas de la liste d'ingrédients.",
  },
  {
    title: 'Des promesses miracles… interdites',
    text: "En Europe, aucune allégation de santé n'est autorisée à ce jour pour les probiotiques. Une étiquette qui promet un ventre plat en 7 jours vous en dit surtout long sur son marketing.",
  },
];
---
<section class="section section--tint problem" aria-labelledby="problem-title" data-problem>
  <div class="container problem__grid">
    <div class="problem__head">
      <p class="eyebrow">Le problème</p>
      <h2 id="problem-title">Le rayon probiotiques est un brouillard.</h2>
      <p class="lead">Des dizaines de boîtes, des chiffres partout, et presque aucun moyen de comparer. Voici les 4 pièges qu'on retrouve sur la plupart des étiquettes.</p>
    </div>
    <ol class="problem__list">
      {traps.map((t, i) => (
        <li class="trap" data-trap data-claims-ok>
          <span class="trap__num num" aria-hidden="true">0{i + 1}</span>
          <div>
            <h3>{t.title}</h3>
            <p class="muted">{t.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <p class="container problem__transition">Voici ce que je regarde à la place <span aria-hidden="true">↓</span></p>
</section>

<style>
  .problem__grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(40px, 7vw, 112px); align-items: start; }
  /* Titre collant sur desktop : CSS sticky plutôt qu'un pin GSAP (zéro JS, zéro saut de layout) */
  .problem__head { position: sticky; top: 120px; }
  .problem__head .lead { margin-top: 20px; }
  .problem__list { list-style: none; padding: 0; display: grid; gap: clamp(16px, 2.5vw, 24px); counter-reset: none; }
  .trap {
    display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: start;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: clamp(22px, 3vw, 32px);
  }
  .trap h3 { margin-bottom: 8px; }
  .trap__num { font-size: var(--fs-sm); font-weight: 700; color: var(--accent); padding-top: 3px; letter-spacing: .04em; }
  .problem__transition { margin-top: clamp(48px, 7vw, 88px); font-size: var(--fs-lg); font-weight: 620; }
  @media (max-width: 860px) {
    .problem__grid { grid-template-columns: 1fr; }
    .problem__head { position: static; }
  }
</style>
