---
import { ctaHref, product } from '../config';
---
<!-- Barre CTA mobile : visible après le hero, masquée sur la section finale (scripts/micro.ts) -->
<div class="sticky-cta" data-sticky-cta hidden>
  <a class="btn" href={ctaHref} rel="sponsored nofollow noopener" data-cta="sticky">
    Découvrir {product.name}<span class="btn__arrow" aria-hidden="true">→</span>
  </a>
  <p>Lien affilié · sans surcoût</p>
</div>

<style>
  .sticky-cta {
    position: fixed; inset: auto 12px 12px; z-index: 40; display: none;
    padding: 10px; border-radius: 24px; background: var(--glass);
    backdrop-filter: blur(14px) saturate(160%); -webkit-backdrop-filter: blur(14px) saturate(160%);
    border: 1px solid var(--line); box-shadow: var(--shadow);
    padding-bottom: max(10px, env(safe-area-inset-bottom));
    transition: transform 300ms var(--ease-out), opacity 300ms var(--ease-out);
  }
  .sticky-cta .btn { width: 100%; }
  .sticky-cta p { text-align: center; font-size: var(--fs-xs); color: var(--ink-2); margin-top: 6px; }
  .sticky-cta.is-hidden { transform: translateY(calc(100% + 24px)); opacity: 0; pointer-events: none; }
  @media (max-width: 720px) { .sticky-cta:not([hidden]) { display: block; } }
</style>
